<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/background"
            app:title="Cuentas por cobrar/pagar"
            app:titleTextAppearance="@style/Text.Heading"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/text_secondary"
            style="@style/Widget.Toolbar.Minimal" />

        <TextView
            android:id="@+id/tv_total_cobrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Por cobrar: $0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_total_pagar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Por pagar: $0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filtrar_cuentas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Filtrar cuentas"
            android:textSize="14sp"
            style="@style/Button.Outline"
            app:strokeColor="@color/green_primary"
            android:textColor="@color/green_primary"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_agregar_cuenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Nueva cuenta"
            android:textSize="16sp"
            style="@style/Button.Primary"
            app:cornerRadius="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_cuentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <TextView
            android:id="@+id/tv_sin_datos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay cuentas registradas"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>