<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OasisCheck" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryDark">@color/green_primary_dark</item>
        <item name="colorAccent">@color/green_primary</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.OasisCheck.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryDark">@color/green_primary_dark</item>
        <item name="colorAccent">@color/green_primary</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Estilos de tarjetas minimalistas -->
    <style name="Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="Card.Minimal">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Card.Minimal.Border">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_light</item>
    </style>

    <!-- Estilos de botones -->
    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="rippleColor">@color/green_primary_light</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="rippleColor">@color/border_light</item>
    </style>

    <!-- Estilos de inputs - simplificados -->
    <style name="Input.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/background</item>
    </style>

    <style name="Input.Filled" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/background_surface</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <!-- Switch minimalista -->
    <style name="Switch.Minimal" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="colorControlActivated">@color/green_primary</item>
        <item name="colorControlNormal">@color/border_light</item>
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/border_light</item>
    </style>

    <!-- Estilos de texto -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Heading">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Label">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.BottomNavigation.Minimal" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">20dp</item>
        <item name="itemTextAppearanceActive">@style/Text.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/Text.BottomNav.Inactive</item>
    </style>

    <style name="ThemeOverlay.BottomNavigation.Minimal">
        <item name="colorPrimary">@color/nav_active</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/nav_background</item>
        <item name="colorOnSurface">@color/nav_inactive</item>
    </style>

    <style name="ThemeOverlay.BottomNavigation">
        <item name="colorPrimary">@color/nav_active</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/nav_background</item>
        <item name="colorOnSurface">@color/nav_inactive</item>
    </style>

    <style name="ThemeOverlay">
        <item name="colorPrimary">@color/green_primary</item>
    </style>

    <style name="Widget">
        <item name="android:background">@color/background</item>
    </style>

    <style name="Text.BottomNav.Active">
        <item name="android:textColor">@color/nav_active</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.BottomNav.Inactive">
        <item name="android:textColor">@color/nav_inactive</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Text.BottomNav">
        <item name="android:textColor">@color/nav_inactive</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- MaterialToolbar minimalista -->
    <style name="Widget.Toolbar.Minimal" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- SearchView minimalista -->
    <style name="Widget.Search">
        <item name="android:background">@color/background</item>
    </style>

    <style name="Widget.Search.Minimal">
        <item name="android:background">@color/background</item>
        <item name="queryHint">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_secondary</item>
    </style>

    <!-- Estilos compatibles con código existente -->
    <style name="InputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <style name="Widget.Oasis.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Oasis.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>