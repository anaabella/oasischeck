<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/background"
            app:title="Reportes"
            app:titleTextAppearance="@style/Text.Heading"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/text_secondary"
            style="@style/Widget.Toolbar.Minimal" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_periodo_actual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico completo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_periodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todo"
                style="@style/Button.Outline"
                app:strokeColor="@color/green_primary"
                android:textColor="@color/green_primary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comparación"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_comp_ventas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ventas: $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_comp_gastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gastos: $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_comp_neto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Neto: $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="División de Ganancias"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_div_emprendimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Emprendimiento (50%): $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_div_ana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ana (25%): $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_div_clau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clau (25%): $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_div_wish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fondo Wishlist (10%): $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado del Dinero"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_estado_emprendimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Emprendimiento: $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_estado_retirado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retirado: $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_estado_oasis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dejado en Oasis: $0"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top Plantas Más Vendidas"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_top_plantas"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_exportar_csv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:text="Exportar CSV"
                    style="@style/Button.Outline"
                    app:strokeColor="@color/green_primary"
                    android:textColor="@color/green_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_exportar_pdf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:text="Exportar PDF"
                    style="@style/Button.Outline"
                    app:strokeColor="@color/green_primary"
                    android:textColor="@color/green_primary" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>