<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/background" app:navigationIcon="@drawable/ic_close" app:title="Configuración" app:titleTextAppearance="@style/Text.Heading" app:titleTextColor="@color/text_primary" app:navigationIconTint="@color/text_secondary" style="@style/Widget.Toolbar.Minimal" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Opciones de la app" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:paddingHorizontal="16dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Balance" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_cierre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Cierre de caja" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_sheets" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Configurar Google Sheets" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_reportes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Reportes" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_compartir" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Compartir Resumen" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_export" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Exportar / Importar" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apariencia" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:paddingHorizontal="16dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_config_tema" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="Cambiar a Modo Claro (Día)" style="@style/Button.Outline" app:strokeColor="@color/green_primary" android:textColor="@color/green_primary"/>

    </LinearLayout>
</ScrollView>